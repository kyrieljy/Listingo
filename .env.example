# Copy to .env.production. Never commit the actual file.
LISTINGO_ENV_FILE=.env.production
LISTINGO_PRODUCTION=true
LISTINGO_TESTING=false
LISTINGO_PORT=8000
LISTINGO_DATABASE_URL=postgresql://listingo:CHANGE_ME@host.docker.internal:5432/listingo
LISTINGO_REDIS_URL=redis://redis:6379/0
LISTINGO_STORAGE_BACKEND=redis
LISTINGO_DATA_DIR=/app/data
LISTINGO_PUBLIC_ASSET_BASE_URL=https://listingo.net
LISTINGO_CORS_ORIGINS=https://listingo.net
LISTINGO_COOKIE_SECURE=true
LISTINGO_BOOTSTRAP_ADMIN_PHONE=REPLACE_WITH_REAL_ADMIN_PHONE
# Only trust the frontend container. Keep this aligned with Compose IPAM.
LISTINGO_TRUSTED_PROXIES=172.30.87.11
LISTINGO_GLOBAL_DRY_RUN=true
LISTINGO_ICP_NUMBER=
LISTINGO_SUPPORT_CONTACT=
# Set true only after merchant binding and Native approval are complete.
LISTINGO_WECHAT_PAY_ENABLED=false
LISTINGO_WECHAT_MCHID=
LISTINGO_WECHAT_APPID=
LISTINGO_WECHAT_API_V3_KEY=
LISTINGO_WECHAT_MERCHANT_SERIAL=
LISTINGO_WECHAT_PRIVATE_KEY_PATH=/run/secrets/listingo/apiclient_key.pem
LISTINGO_WECHAT_PUBLIC_KEY_ID=
LISTINGO_WECHAT_PUBLIC_KEY_PATH=/run/secrets/listingo/wechatpay_public.pem
LISTINGO_WECHAT_NOTIFY_URL=https://listingo.net/api/v1/payments/wechat/notify
LISTINGO_WECHAT_RECONCILE_INTERVAL_SECONDS=60
